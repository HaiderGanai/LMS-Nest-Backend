#
# Backend runtime configuration (example)
#

# Core
PORT=5005
NODE_ENV=production

# Data backend
DATA_BACKEND=mongo
MONGO_URI=mongodb://127.0.0.1:27017/tarteel_v2
MONGO_DB_NAME=tarteel_v2
MONGO_MAX_POOL=20

# Firebase Admin
# Keep this true if you need FCM push notifications.
ENABLE_FIREBASE_ADMIN=true

# Provide Firebase Admin credentials through environment or an external file path.
# Do not commit service-account JSON files to this repository.
# Option A: inline the full JSON object on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: set the individual fields directly.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option C: point GOOGLE_APPLICATION_CREDENTIALS at a file outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json

# When true, Firebase Admin is used for messaging only (FCM).
# Firestore client will not be initialized by the backend.
FIREBASE_FCM_ONLY=true

# activeCalls MongoDB persistence
# Saves the in-memory activeCalls Map to MongoDB so active call state survives
# server restarts. Works with DATA_BACKEND=mongo (no Firestore required).
# Defaults to true when DATA_BACKEND=mongo — set false only in testing.
ENABLE_ACTIVE_CALLS_PERSISTENCE=true
# Legacy alias kept for backward compatibility (new name takes priority):
ENABLE_FIRESTORE_RUNTIME_STATE=true
# How far back to look when restoring calls on startup (stale calls are dropped):
# ACTIVE_CALLS_RESTORE_MAX_AGE_MS=7200000  # default: 2 hours

# Janus Gateway public WebSocket URL served to client apps.
# MUST be wss:// (TLS) in production. Set via Nginx proxy_pass on port 8188.
# Example: wss://media.yourdomain.com/janus-ws
JANUS_PUBLIC_URL=wss://media.bakamal.online/janus-ws

# ICE (STUN/TURN) server list delivered to client apps via /api/config.
# Preferred: set ICE_SERVERS_JSON to a JSON array of RTCIceServer objects.
# Example (escape quotes for shell env):
# ICE_SERVERS_JSON=[{"urls":"stun:turn.example.com:3478"},{"urls":"turn:turn.example.com:3478?transport=udp","username":"user","credential":"pass"}]
#
# Simple alternative: set TURN_HOST + TURN_USERNAME + TURN_CREDENTIAL and the
# server builds the ICE list automatically (udp + tcp + stun on the same host).
TURN_HOST=turn.bakamal.online
TURN_PORT=3478
TURN_USERNAME=shahzaib
TURN_CREDENTIAL=tarteel

# Storage (S3) for LMS uploads/downloads (presigned URLs generated by backend)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_PRESIGN_DEFAULT_EXPIRES_SECONDS=300
STORAGE_PRESIGN_MAX_EXPIRES_SECONDS=3600

# Auth/JWT
AUTH_ACCESS_TOKEN_SECRET=change-me
AUTH_REFRESH_TOKEN_SECRET=change-me
AUTH_INTERNAL_API_KEY=change-me

# Security toggles
AUTH_ENFORCE_REST_AUTH=true
AUTH_REQUIRE_HTTPS=true

# Role-to-app policy:
# teacher -> teacher app only
# parent  -> parent app + student app
# student -> student app
# other staff (admin/manager/etc) -> LMS only
AUTH_ROLE_CLIENT_ENFORCEMENT=true

# Optional hard lock: if true, only parent accounts can login/refresh globally.
AUTH_PARENT_ONLY_LOGIN=false

# Hosted invoice checkout gateways
# Stripe Checkout uses the official Checkout Sessions API.
STRIPE_SECRET_KEY=
STRIPE_API_VERSION=2026-02-25.clover

# PayPal Orders v2 checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Allowed values: sandbox | live
PAYPAL_ENV=sandbox

# Optional public origin override for payment success/cancel pages.
# If omitted, the backend derives the public origin from the incoming request.
# Example: https://t-api.bakamal.online
PAYMENT_PUBLIC_BASE_URL=
